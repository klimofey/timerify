{
  "entity": {
    "button": {
      "turn_off": {
        "default": "mdi:power"
      }
    },
    "number": {
      "run_for": {
        "default": "mdi:timer-outline"
      }
    },
    "sensor": {
      "ends_at": {
        "default": "mdi:clock-end"
      },
      "next_command": {
        "default": "mdi:calendar-clock"
      },
      "runtime": {
        "default": "mdi:timer-sand-complete"
      }
    },
    "switch": {
      "interval": {
        "default": "mdi:calendar-check",
        "state": {
          "off": "mdi:calendar-remove"
        }
      }
    }
  },
  "services": {
    "add_time": {
      "service": "mdi:timer-plus-outline"
    },
    "run": {
      "service": "mdi:timer-play-outline"
    },
    "stop": {
      "service": "mdi:timer-stop-outline"
    },
    "add_command": {
      "service": "mdi:clock-plus-outline"
    },
    "cancel_command": {
      "service": "mdi:clock-remove-outline"
    }
  }
}
