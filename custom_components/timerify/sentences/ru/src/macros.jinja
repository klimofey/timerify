{#- The macros of Timerify's answers in Russian, written once, here. The generator
    (scripts/generate_sentences.py) puts the definition of each macro that an answer calls,
    and of the macros those call, in front of the answer, since an answer is rendered on
    its own. A macro is a block from `macro` to `endmacro`, and calls only the macros above
    it. Everything between the blocks is a comment. -#}

{#- The word for a count, by the Russian rule: `one` for 1, 21, 31 and so on but not 11,
    `few` for 2-4, 22-24 and so on but not 12-14, `many` for any other count. -#}
{%- macro plural(n, one, few, many) -%}
  {%- if n % 10 == 1 and n % 100 != 11 -%}
    {{ one }}
  {%- elif n % 10 in [2, 3, 4] and n % 100 not in [12, 13, 14] -%}
    {{ few }}
  {%- else -%}
    {{ many }}
  {%- endif -%}
{%- endmacro -%}

{#- Words the number of dates between today and the day a timer ends on: nothing for today,
    and a trailing space after the words, so that they precede a time. -#}
{%- macro day(n) -%}
  {%- if n == 1 -%}
    {{ "завтра " }}
  {%- elif n == 2 -%}
    {{ "послезавтра " }}
  {%- elif n > 2 -%}
    {{ "через " ~ n ~ " " ~ plural(n, "день", "дня", "дней") ~ " " }}
  {%- endif -%}
{%- endmacro -%}

{#- Hours and minutes after "на", with their units in the accusative: "1 час и 30 минут",
    "1 минуту". Nothing for neither. -#}
{%- macro duration_for(hours, minutes) -%}
  {%- set parts = [] -%}
  {%- if hours > 0 -%}
    {%- set parts = parts + [hours ~ " " ~ plural(hours, "час", "часа", "часов")] -%}
  {%- endif -%}
  {%- if minutes > 0 -%}
    {%- set parts = parts + [minutes ~ " " ~ plural(minutes, "минуту", "минуты", "минут")] -%}
  {%- endif -%}
  {{- parts | join(" и ") -}}
{%- endmacro -%}

{#- Where a timer stands after it was run, extended or stopped, from the slots a handler
    gives: counting, on with a limit (the latest time it turns off, since nobody chose a
    time), on without a timer, or off. A command's answer gives the wish it set, whatever
    the target shows, so a target that is unavailable after a stop (state "unavailable")
    is answered off on purpose; the answer to a question about the timer is the one that
    says unavailable. The name goes first, since it cannot be declined. -#}
{%- macro timer_now(slots) -%}
  {%- if slots.state == "counting" -%}
    {{ slots.target }}: включено на {{ duration_for(slots.left_hours, slots.left_minutes) }}, выключится {{ day(slots.ends_in_days) }}в {{ slots.ends_at }}.
  {%- elif slots.state == "limit" -%}
    {{ slots.target }}: включено, выключится {{ day(slots.ends_in_days) }}не позже {{ slots.ends_at }}.
  {%- elif slots.state == "open" -%}
    {{ slots.target }}: включено.
  {%- else -%}
    {{ slots.target }}: выключено.
  {%- endif -%}
{%- endmacro -%}

{#- What a command for later did, from the slots a handler gives: a command to turn on
    was kept, the countdown was set to turn off, or there was nothing to turn off. The
    name goes first, since it cannot be declined. -#}
{%- macro timer_later(slots) -%}
  {%- if slots.outcome == "command_added" -%}
    {{ slots.target }}: включится {{ day(slots.in_days) }}в {{ slots.at }}.
  {%- elif slots.outcome == "timer_set" -%}
    {{ slots.target }}: выключится {{ day(slots.ends_in_days) }}в {{ slots.ends_at }}.
  {%- else -%}
    {{ slots.target }}: уже выключено, ничего не изменилось.
  {%- endif -%}
{%- endmacro -%}

{#- A planned command, from the slots a handler gives it: what it does, when, and for how
    long a command to turn on then runs, if it has a time of its own. What it turns the
    device on with is not said. -#}
{%- macro planned_command(command) -%}
  {{ "включить" if command.action == "on" else "выключить" }} {{ day(command.in_days) }}в {{ command.at }}
  {%- if command.minutes -%}
    {{ " на " ~ duration_for(command.minutes // 60, command.minutes % 60) }}
  {%- endif -%}
{%- endmacro -%}

{#- The titles of schedule intervals, in the order they are given, each in guillemets, set
    apart by commas and the last after "и": «A», «A» и «B», «A», «B» и «C». A title may
    have a comma, as the one Timerify makes does, which the guillemets keep from setting
    titles apart. -#}
{%- macro quoted_titles(titles) -%}
  {%- for title in titles -%}
    «{{ title }}»{{ " и " if loop.revindex == 2 else (", " if not loop.last else "") }}
  {%- endfor -%}
{%- endmacro -%}

{#- The planned commands, in the order they are given, set apart by semicolons. -#}
{%- macro planned_commands(commands) -%}
  {%- for command in commands -%}
    {{ planned_command(command) }}{{ "; " if not loop.last else "" }}
  {%- endfor -%}
{%- endmacro -%}
